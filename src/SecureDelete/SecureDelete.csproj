<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <AssemblyName>SecureDelete</AssemblyName>
    <RootNamespace>SecureDelete</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\appicon.ico</ApplicationIcon>

    <Product>Secure Delete</Product>
    <AssemblyTitle>Secure Delete</AssemblyTitle>
    <Company>MIT license</Company>
    <Description>Safe Windows Explorer wrapper around Microsoft Sysinternals SDelete.</Description>
    <Version>1.0.0</Version> <!-- x-release-please-version -->
    <Copyright>Copyright (c) 2026 Jessie Wadman</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecureDelete.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\appicon.ico" />
  </ItemGroup>

</Project>
