<Window x:Class="SecureDelete.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Delete"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" FontSize="13">

    <Border Padding="20">
        <Grid>
            <!-- ===================== Confirmation ===================== -->
            <StackPanel x:Name="ConfirmPanel">
                <TextBlock x:Name="HeadingText"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           TextWrapping="Wrap"
                           Text="Securely delete this item?"/>

                <Border Margin="0,12,0,0" Padding="12,10"
                        Background="White" BorderBrush="{StaticResource NeutralBorder}"
                        BorderThickness="1" CornerRadius="6">
                    <TextBlock x:Name="TargetPathText"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="Consolas, Segoe UI"
                               TextWrapping="Wrap" MaxHeight="60"
                               TextTrimming="CharacterEllipsis"
                               Text="C:\path\to\target"/>
                </Border>

                <TextBlock Margin="0,12,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           Text="This operation permanently removes the selected item and cannot be undone."/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Overwrite passes:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"/>
                    <ComboBox x:Name="PassesCombo" Width="70" Height="28" Margin="10,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="Cancel"
                            Style="{StaticResource NeutralButton}" IsCancel="True"
                            Click="OnCancel"/>
                    <Button x:Name="DeleteButton" Content="Secure Delete"
                            Style="{StaticResource DangerButton}" IsDefault="True"
                            Click="OnSecureDelete"/>
                </StackPanel>
            </StackPanel>

            <!-- ===================== Progress ===================== -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="ProgressHeading"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Text="Securely deleting…"/>

                <ProgressBar x:Name="Progress" IsIndeterminate="True"
                             Height="6" Margin="0,16,0,0"
                             Foreground="{StaticResource Danger}"
                             Background="#FFE2E8F0" BorderThickness="0"/>

                <TextBlock x:Name="ProgressStatus" Margin="0,12,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           Text="Processing…"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="AbortButton" Content="Abort"
                            Style="{StaticResource NeutralButton}"
                            Click="OnAbort"/>
                </StackPanel>
            </StackPanel>

            <!-- ===================== Result ===================== -->
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                <TextBlock x:Name="ResultHeading"
                           FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="Completed successfully."/>

                <TextBlock x:Name="ResultMessage" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           Text=""/>

                <Expander x:Name="DetailsExpander" Header="Details" Margin="0,12,0,0"
                          Visibility="Collapsed" Foreground="{StaticResource TextSecondary}">
                    <Border Margin="0,8,0,0" Background="White"
                            BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1"
                            CornerRadius="6">
                        <TextBox x:Name="DetailsText" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas, Segoe UI" FontSize="12"
                                 TextWrapping="Wrap" MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10" Text=""/>
                    </Border>
                </Expander>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CloseButton" Content="Close"
                            Style="{StaticResource NeutralButton}" IsDefault="True"
                            Click="OnClose"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
